{
  // Cloudflare Workers con Static Assets + Worker script embebido para OAuth de Decap CMS.
  "name": "dla-castro",
  "compatibility_date": "2025-01-01",
  "main": "src/worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
}

<script>
  const TOAST_DURATION = 7000;

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btnSubmit = form?.querySelector('.btn-submit') as HTMLButtonElement | null;
  const btnText = form?.querySelector('.btn-text') as HTMLSpanElement | null;
  const btnSpinner = form?.querySelector('.btn-spinner') as HTMLSpanElement | null;
  const whatsappNumber = form?.dataset.whatsapp || '';

  let activeToast: HTMLElement | null = null;
  let toastTimer: number | null = null;
  let toastRemaining = TOAST_DURATION;
  let toastStartTime = 0;
  let isPaused = false;

  /* ── Helpers ── */

  function buildWaUrl(): string {
    if (!whatsappNumber || whatsappNumber === 'TODO_NUMERO_WHATSAPP') return '#';
    const cleanNumber = whatsappNumber.replace(/\D/g, '');
    const message = 'Hola, me comunico desde el sitio web de DLA para agendar una evaluación legal.';
    return `https://wa.me/${cleanNumber}?text=${encodeURIComponent(message)}`;
  }

  function setLoading(loading: boolean) {
    if (!btnSubmit || !btnText || !btnSpinner) return;
    btnSubmit.disabled = loading;
    btnSubmit.classList.toggle('is-loading', loading);
    btnText.textContent = loading ? 'Enviando…' : 'Enviar Evaluación Legal';
  }

  function clearToastTimer() {
    if (toastTimer !== null) {
      window.clearTimeout(toastTimer);
      toastTimer = null;
    }
  }

  function pauseToast() {
    if (!activeToast || isPaused || toastRemaining <= 0) return;
    isPaused = true;
    clearToastTimer();
    const elapsed = Date.now() - toastStartTime;
    toastRemaining = Math.max(0, toastRemaining - elapsed);
    const progressBar = activeToast.querySelector('.toast-progress-bar') as HTMLElement | null;
    if (progressBar) {
      progressBar.style.animationPlayState = 'paused';
    }
  }

  function resumeToast() {
    if (!activeToast || !isPaused || toastRemaining <= 0) return;
    isPaused = false;
    toastStartTime = Date.now();
    const progressBar = activeToast.querySelector('.toast-progress-bar') as HTMLElement | null;
    if (progressBar) {
      progressBar.style.animationPlayState = 'running';
    }
    toastTimer = window.setTimeout(() => dismissToast(), toastRemaining);
  }

  function startCloseTimer() {
    clearToastTimer();
    toastRemaining = TOAST_DURATION;
    toastStartTime = Date.now();
    isPaused = false;
    toastTimer = window.setTimeout(() => dismissToast(), toastRemaining);
  }

  /* ── Dismiss ── */

  function dismissToast() {
    if (!activeToast) return;
    clearToastTimer();
    const toastToDismiss = activeToast;
    activeToast = null;
    toastToDismiss.classList.remove('toast-visible');
    toastToDismiss.classList.add('toast-exiting');

    toastToDismiss.addEventListener('transitionend', () => {
      toastToDismiss.remove();
    }, { once: true });

    /* Fallback por si no dispara transitionend */
    window.setTimeout(() => {
      toastToDismiss.remove();
    }, 350);
  }

  /* ── Build toast DOM ── */

  function buildToast(type: 'success' | 'error'): HTMLElement {
    const el = document.createElement('div');
    el.className = `toast toast-${type}`;
    el.setAttribute('role', type === 'error' ? 'alert' : 'status');
    el.setAttribute('aria-live', type === 'error' ? 'assertive' : 'polite');
    el.setAttribute('aria-atomic', 'true');

    const checkIcon = `
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    `;

    const errorIcon = `
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
    `;

    const title = type === 'success'
      ? 'Consulta enviada correctamente'
      : 'No se pudo enviar la consulta';

    const subtitle = type === 'success'
      ? 'Un profesional de DLA revisará su caso y se pondrá en contacto a la brevedad.'
      : 'Hubo un problema de conexión. Puede reintentar el envío o escribirnos directamente por WhatsApp.';

    const waUrl = buildWaUrl();
    const waIcon = `
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    `;

    const waBtn = waUrl !== '#'
      ? `<a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="toast-btn-wa" aria-label="Contactar directamente por WhatsApp">${waIcon}<span>WhatsApp Directo</span></a>`
      : '';

    const retryBtn = type === 'error'
      ? '<button type="button" class="toast-btn-retry" aria-label="Reintentar envío del formulario">Reintentar</button>'
      : '';

    const closeIcon = `
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    `;

    el.innerHTML = `
      <div class="toast-header">
        <span class="toast-icon">${type === 'success' ? checkIcon : errorIcon}</span>
        <div class="toast-text">
          <span class="toast-title">${title}</span>
          <span class="toast-subtitle">${subtitle}</span>
        </div>
        <button type="button" class="toast-close" aria-label="Cerrar notificación">${closeIcon}</button>
      </div>
      <div class="toast-actions">${retryBtn}${waBtn}</div>
      <div class="toast-progress" aria-hidden="true"><div class="toast-progress-bar"></div></div>
    `;

    /* Events — pause/resume on hover & focus */
    el.addEventListener('mouseenter', pauseToast);
    el.addEventListener('mouseleave', resumeToast);
    el.addEventListener('focusin', pauseToast);
    el.addEventListener('focusout', (e) => {
      if (!el.contains(e.relatedTarget as Node)) resumeToast();
    });

    /* Close button */
    el.querySelector('.toast-close')?.addEventListener('click', dismissToast);

    /* Retry button */
    if (type === 'error') {
      el.querySelector('.toast-btn-retry')?.addEventListener('click', dismissToast);
    }

    return el;
  }

  /* ── Show toast ── */

  function showToast(type: 'success' | 'error') {
    dismissToast();
    const el = buildToast(type);
    const wrapper = form?.querySelector('.form-submit-wrapper') || form || document.body;
    wrapper.appendChild(el);
    activeToast = el;
    /* Forzar reflow antes de activar clase visible para animación CSS */
    void el.offsetHeight;
    el.classList.add('toast-visible');
    startCloseTimer();
  }

  /* ── Submit handler ── */

  async function handleSubmit(e: Event) {
    e.preventDefault();
    if (!form || !btnSubmit) return;

    const honeypot = form.elements.namedItem('website') as HTMLInputElement | null;
    if (honeypot?.value) return;

    setLoading(true);

    const payload = {
      nombre: (form.elements.namedItem('nombre') as HTMLInputElement)?.value.trim(),
      tipoCaso: (form.elements.namedItem('tipoCaso') as HTMLSelectElement)?.value,
      aseguradora: (form.elements.namedItem('aseguradora') as HTMLInputElement)?.value.trim(),
      telefono: (form.elements.namedItem('telefono') as HTMLInputElement)?.value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement)?.value.trim(),
      mensaje: (form.elements.namedItem('mensaje') as HTMLTextAreaElement)?.value.trim(),
    };

    try {
      const res = await fetch('/api/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) throw new Error(`HTTP ${res.status}`);

      form.reset();
      setLoading(false);
      showToast('success');
    } catch {
      setLoading(false);
      showToast('error');
    }
  }

  form?.addEventListener('submit', handleSubmit);
</script>
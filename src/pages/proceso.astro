---
// "Procesos y Estrategia Jurídica" + Timeline completo de Ruta Crítica del Reclamo.
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import FramedImage from '../components/FramedImage.astro';

// Imágenes de proceso — safe import
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/proceso/*.{jpg,jpeg,png}',
  { eager: false },
);
async function safeImg(path: string) {
  try { return (await imageModules[path]()).default; }
  catch { return null; }
}
const pilImg1 = await safeImg('../assets/images/proceso/diagnostico-tecnico.jpg');
const pilImg2 = await safeImg('../assets/images/proceso/via-administrativa-aps.jpg');
const pilImg3 = await safeImg('../assets/images/proceso/prueba-tecnica-peritaje.jpg');
const pilImages = [pilImg1, pilImg2, pilImg3];

const schemaExtra = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://dlaseguros.bo/' },
    { '@type': 'ListItem', position: 2, name: 'Proceso', item: 'https://dlaseguros.bo/proceso/' },
  ],
};

const pilares = [
  {
    numero: '01',
    titulo: 'Diagnóstico de Cobertura',
    descripcion: 'Revisamos la póliza letra a letra antes de cualquier reclamación formal. Identificamos discrepancias entre las condiciones generales y particulares.',
    imagen: '../assets/images/proceso/diagnostico-tecnico.jpg',
  },
  {
    numero: '02',
    titulo: 'Vía Administrativa APS',
    descripcion: 'Agotamos oportunamente las instancias ante la Autoridad de Fiscalización y Control de Pensiones y Seguros (APS), donde se resuelven el 82% de las objeciones sin ir a tribunales.',
    imagen: '../assets/images/proceso/via-administrativa-aps.jpg',
  },
  {
    numero: '03',
    titulo: 'Prueba Técnica y Peritaje',
    descripcion: 'Contamos con respaldo técnico para cuestionar informes de ajustadores de siniestros que hayan subvaluado o rechazado indebidamente el perjuicio.',
    imagen: '../assets/images/proceso/prueba-tecnica-peritaje.jpg',
  },
];

const fases = [
  {
    numero: 1,
    titulo: 'Ocurrencia y Diagnóstico Inicial',
    descripcion: 'Aviso formal de siniestro, verificación técnica de la póliza y fiscalización estricta de los plazos legales prescritos por ley.',
    anotacion: 'Art. 1028 Cód. Comercio',
    cta: { label: 'Revisar plazos legales', href: '/contacto/' },
  },
  {
    numero: 2,
    titulo: 'Liquidación y Peritaje Técnico',
    descripcion: 'Aportación rigurosa de evidencias, contrarresto del informe del ajustador/perito y verificación cuantitativa del daño.',
    anotacion: 'Reglamentación APS',
  },
  {
    numero: 3,
    titulo: 'Impugnación de Rechazos y Objeciones',
    descripcion: 'Formulación de recurso administrativo ante la aseguradora y la APS frente a cartas de rechazo o liquidaciones insuficientes.',
    anotacion: 'Reclamación Administrativa APS',
    cta: { label: 'Impugnar rechazo →', href: '/areas-de-practica/impugnacion-de-rechazos/' },
  },
  {
    numero: 4,
    titulo: 'Ejecución y Vía Arbitral / Judicial',
    descripcion: 'Exigencia de pago inmediato o activación de la cláusula arbitral y patrocinio judicial en caso de objeción persistente.',
    anotacion: 'Arbitraje · Litigio Comercial',
  },
];
---

<BaseLayout
  title="Proceso Jurídico"
  description="Cómo trabajamos en DLA: diagnóstico técnico de pólizas, estrategia de conciliación, impugnación administrativa APS y cobro de indemnizaciones."
  schemaExtra={schemaExtra}
>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <filter id="duotone-navy" color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="
        0.33 0.33 0.33 0 0
        0.33 0.33 0.33 0 0
        0.33 0.33 0.33 0 0
        0    0    0    1 0" />
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.0588 0.9686" />
        <feFuncG type="table" tableValues="0.1059 0.9176" />
        <feFuncB type="table" tableValues="0.2392 0.7843" />
      </feComponentTransfer>
    </filter>
  </svg>

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Ruta de navegación">
    <div class="breadcrumb-inner">
      <a href="/" class="breadcrumb-link">Inicio</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span class="breadcrumb-current" aria-current="page">Proceso</span>
    </div>
  </nav>

  <!-- Hero Proceso -->
  <header class="proceso-hero">
    <div class="proceso-hero-inner">
      <p class="eyebrow">Metodología de trabajo</p>
      <h1 class="proceso-title">Proceso y Estrategia Jurídica</h1>
      <p class="proceso-subtitle">
        Una metodología estructurada en 4 fases diseñadas para reducir la incertidumbre,
        hacer cumplir la normativa legal y maximizar las probabilidades de indemnización.
      </p>
    </div>
  </header>

  <!-- Timeline (Elemento de Firma) -->
  <Timeline fases={fases} />

  <!-- Profundización estratégica -->
  <section class="estrategia-section">
    <div class="section-inner">
      <div class="section-header">
        <p class="eyebrow">Rigores de procedimiento</p>
        <h2 class="section-title">Pilares de la Estrategia en Seguros</h2>
      </div>

      <div class="pilares-grid">
        {pilares.map((p, i) => (
          <div class="pilar-card">
            {pilImages[i] && (
              <FramedImage
                src={pilImages[i]}
                alt={`${p.titulo} — DLA`}
                aspectRatio="4/3"
                widths={[400, 800]}
                sizes="(max-width: 900px) 100vw, 33vw"
                quality={78}
              />
            )}
            <div class="pilar-num">{p.numero}</div>
            <h3 class="pilar-title">{p.titulo}</h3>
            <p class="pilar-desc">{p.descripcion}</p>
          </div>
        ))}
      </div>

      <div class="proceso-cta-box">
        <div class="cta-box-text">
          <h3>¿Tiene un siniestro en curso o una carta de rechazo?</h3>
          <p>Los plazos en seguros son caducos. Evaluemos su expediente de forma inmediata.</p>
        </div>
        <a href="/contacto/" class="btn-cta-proceso">Solicitar Evaluación Técnica</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb { background: rgba(15, 27, 61, 0.02); border-bottom: 1px solid rgba(15, 27, 61, 0.06); padding: 0.75rem 0; }
  .breadcrumb-inner { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; display: flex; align-items: center; gap: 0.5rem; }
  .breadcrumb-link { font-family: var(--font-body); font-size: 0.8125rem; color: var(--color-ink-400); text-decoration: none; }
  .breadcrumb-link:hover { color: var(--color-navy-800); }
  .breadcrumb-sep { color: var(--color-ink-400); font-size: 0.75rem; }
  .breadcrumb-current { font-family: var(--font-body); font-size: 0.8125rem; color: var(--color-navy-800); font-weight: 500; }

  .proceso-hero { background: linear-gradient(135deg, var(--color-navy-950) 0%, var(--color-navy-800) 100%); color: var(--color-white); padding: 4rem 0; }
  .proceso-hero-inner { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }
  .proceso-title { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 1rem; }
  .proceso-subtitle { font-family: var(--font-body); font-size: 1.0625rem; color: rgba(255,255,255,0.7); line-height: 1.65; max-width: 40rem; }

  .section-inner { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }
  .estrategia-section { padding: 5rem 0; background: var(--color-white); border-top: 1px solid rgba(15, 27, 61, 0.06); }
  .section-header { text-align: center; max-width: 42rem; margin: 0 auto 3rem; }
  .section-title { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: var(--color-navy-800); }

  .pilares-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 4rem; }
  .pilar-card { padding: 2rem; background: rgba(15, 27, 61, 0.02); border: 1px solid rgba(15, 27, 61, 0.08); border-radius: var(--radius-card); }
  .pilar-card :global(.framed-image) { margin-bottom: 1.25rem; }
  .pilar-card :global(.framed-image__img) { filter: url(#duotone-navy); }
  .pilar-num { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-terracotta-600); font-weight: 600; margin-bottom: 0.75rem; }
  .pilar-title { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; color: var(--color-navy-800); margin-bottom: 0.5rem; }
  .pilar-desc { font-family: var(--font-body); font-size: 0.875rem; color: var(--color-ink-600); line-height: 1.6; }

  .proceso-cta-box { background: var(--color-navy-950); color: var(--color-white); padding: 2.5rem; border-radius: var(--radius-card); display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .cta-box-text h3 { font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; margin-bottom: 0.375rem; }
  .cta-box-text p { font-family: var(--font-body); font-size: 0.875rem; color: rgba(255,255,255,0.7); }
  .btn-cta-proceso { font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; color: var(--color-white); background: var(--color-terracotta-600); text-decoration: none; padding: 0.75rem 1.5rem; border-radius: 0.375rem; white-space: nowrap; transition: background-color var(--motion-duration-micro); }
  .btn-cta-proceso:hover { background: var(--color-terracotta-500); }

  @media (max-width: 900px) {
    .pilares-grid { grid-template-columns: 1fr; }
    .proceso-cta-box { flex-direction: column; text-align: center; }
  }
</style>

---
// Post individual de blog.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const categoriasMap: Record<string, string> = {
  normativa: 'Normativa & Leyes',
  siniestros: 'Rechazo de Siniestros',
  jurisprudencia: 'Jurisprudencia & APS',
  general: 'Análisis General',
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-BO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const articleSchema = {
  '@type': 'BlogPosting',
  headline: post.data.titulo,
  description: post.data.resumen,
  datePublished: post.data.fechaPublicacion.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'DLA — Defensa Legal del Asegurado',
  },
};

const schemaExtra = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://dlaseguros.bo/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://dlaseguros.bo/blog/' },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.titulo,
      item: `https://dlaseguros.bo/blog/${post.slug}/`,
    },
  ],
};
---

<BaseLayout
  title={post.data.titulo}
  description={post.data.resumen}
  schemaExtra={{ ...articleSchema, ...schemaExtra }}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Ruta de navegación">
    <div class="breadcrumb-inner">
      <a href="/" class="breadcrumb-link">Inicio</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <a href="/blog/" class="breadcrumb-link">Blog</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span class="breadcrumb-current" aria-current="page">{post.data.titulo}</span>
    </div>
  </nav>

  <!-- Encabezado del artículo -->
  <header class="article-hero">
    <div class="article-hero-inner">
      <div class="article-meta">
        <span class="article-category">
          {categoriasMap[post.data.categoria] || post.data.categoria}
        </span>
        <span class="article-date">{formatDate(post.data.fechaPublicacion)}</span>
      </div>
      <h1 class="article-title">{post.data.titulo}</h1>
      <p class="article-subtitle">{post.data.resumen}</p>
    </div>
  </header>

  <main class="article-main">
    <div class="article-inner">
      {post.data.imagenPortada && (
        <div class="article-cover">
          <Image
            src={post.data.imagenPortada}
            alt={post.data.titulo}
            class="article-cover-img"
            widths={[800, 1200]}
            sizes="(max-width: 640px) 100vw, 52rem"
            loading="eager"
          />
        </div>
      )}

      <!-- Cuerpo del artículo -->
      <article class="article-content prose">
        <Content />
      </article>

      <!-- Pie del artículo / Firma institucional -->
      <footer class="article-author-box">
        <div class="author-box-content">
          <span class="author-box-eyebrow">Publicado por</span>
          <h3 class="author-box-name">DLA — Defensa Legal del Asegurado</h3>
          <p class="author-box-role">Firma especializada en Derecho de Seguros en Bolivia · Abogado responsable: Castro</p>
        </div>
        <div class="author-box-action">
          <a href="/contacto/" class="btn-article-cta">Consultar sobre un caso</a>
        </div>
      </footer>

      <div class="article-back-nav">
        <a href="/blog/" class="btn-back-blog">&larr; Volver al listado de artículos</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .breadcrumb {
    background: rgba(15, 27, 61, 0.02);
    border-bottom: 1px solid rgba(15, 27, 61, 0.06);
    padding: 0.75rem 0;
  }
  .breadcrumb-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .breadcrumb-link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-ink-400);
    text-decoration: none;
    transition: color var(--motion-duration-micro);
  }
  .breadcrumb-link:hover {
    color: var(--color-navy-800);
  }
  .breadcrumb-sep {
    color: var(--color-ink-400);
    font-size: 0.75rem;
  }
  .breadcrumb-current {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-navy-800);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 24rem;
  }

  .article-hero {
    background: linear-gradient(135deg, var(--color-navy-950) 0%, var(--color-navy-800) 100%);
    color: var(--color-white);
    padding: 4rem 0 3.5rem;
  }
  .article-hero-inner {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .article-category {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-terracotta-500);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: rgba(199, 124, 63, 0.15);
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
  }
  .article-date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .article-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }
  .article-subtitle {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.65;
  }

  .article-main {
    padding: 3.5rem 0 5rem;
    background: var(--color-white);
  }
  .article-inner {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .article-cover {
    margin-bottom: 3rem;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .article-cover-img {
    width: 100%;
    max-height: 28rem;
    object-fit: cover;
  }

  /* Estilos de tipografía editorial para contenido markdown */
  .article-content.prose {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-ink-800);
    line-height: 1.8;
  }
  .article-content.prose p {
    margin-bottom: 1.5rem;
  }
  .article-content.prose h2 {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--color-navy-800);
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.01em;
  }
  .article-content.prose h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-navy-800);
    margin: 2rem 0 0.75rem;
  }
  .article-content.prose ul,
  .article-content.prose ol {
    margin: 1.25rem 0 1.5rem 1.5rem;
  }
  .article-content.prose li {
    margin-bottom: 0.5rem;
  }
  .article-content.prose blockquote {
    border-left: 3px solid var(--color-terracotta-600);
    background: rgba(181, 98, 44, 0.04);
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.125rem;
    color: var(--color-navy-800);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  /* Pie del artículo */
  .article-author-box {
    margin-top: 4rem;
    padding: 2rem;
    background: var(--color-navy-950);
    color: var(--color-white);
    border-radius: var(--radius-card);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .author-box-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-terracotta-500);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.25rem;
  }
  .author-box-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .author-box-role {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
  }
  .btn-article-cta {
    display: inline-flex;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-white);
    background: var(--color-terracotta-600);
    text-decoration: none;
    padding: 0.75rem 1.25rem;
    border-radius: 0.375rem;
    white-space: nowrap;
    transition: background-color var(--motion-duration-micro);
  }
  .btn-article-cta:hover {
    background: var(--color-terracotta-500);
  }

  .article-back-nav {
    margin-top: 2.5rem;
  }
  .btn-back-blog {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy-800);
    text-decoration: none;
    transition: color var(--motion-duration-micro);
  }
  .btn-back-blog:hover {
    color: var(--color-terracotta-600);
  }

  @media (max-width: 640px) {
    .article-author-box {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

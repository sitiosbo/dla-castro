---
// Listado de blog (Decap CMS alimenta esta colección).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => b.data.fechaPublicacion.valueOf() - a.data.fechaPublicacion.valueOf()
);

const categoriasMap: Record<string, string> = {
  normativa: 'Normativa & Leyes',
  siniestros: 'Rechazo de Siniestros',
  jurisprudencia: 'Jurisprudencia & APS',
  general: 'Análisis General',
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-BO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const schemaExtra = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://dlaseguros.bo/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://dlaseguros.bo/blog/' },
  ],
};
---

<BaseLayout
  title="Blog y Artículos Técnicos"
  description="Análisis especializado sobre normativa de seguros, regulación APS, impugnación de rechazos y jurisprudencia en Bolivia."
  schemaExtra={schemaExtra}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Ruta de navegación">
    <div class="breadcrumb-inner">
      <a href="/" class="breadcrumb-link">Inicio</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span class="breadcrumb-current" aria-current="page">Blog</span>
    </div>
  </nav>

  <!-- Hero Blog -->
  <header class="blog-hero">
    <div class="blog-hero-inner">
      <p class="eyebrow">Análisis & Jurisprudencia</p>
      <h1 class="blog-title">Blog Técnico de Seguros</h1>
      <p class="blog-subtitle">
        Criterios jurídicos, normativa actualizada y guías técnicas para asegurados,
        empresas y tomadores de pólizas en Bolivia.
      </p>
    </div>
  </header>

  <main class="blog-main">
    <div class="blog-inner">
      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map((post, index) => (
            <a href={`/blog/${post.slug}/`} class="post-card-link" style={`--card-index: ${index}`}>
              <article class="post-card">
              {post.data.imagenPortada && (
                <div class="post-cover-wrap">
                  <Image
                    src={post.data.imagenPortada}
                    alt={post.data.titulo}
                    class="post-cover-img"
                    widths={[400, 800]}
                    sizes="(max-width: 640px) 100vw, (max-width: 992px) 50vw, 33vw"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="post-card-content">
                <div class="post-meta">
                  <span class="post-category">
                    {categoriasMap[post.data.categoria] || post.data.categoria}
                  </span>
                  <span class="post-date">{formatDate(post.data.fechaPublicacion)}</span>
                </div>
                <h2 class="post-title">
                  {post.data.titulo}
                </h2>
                <p class="post-resumen">{post.data.resumen}</p>
                <div class="post-footer">
                  <span class="post-read-more">
                    Leer artículo completo &rarr;
                  </span>
                </div>
              </div>
            </article>
          </a>
        ))}
        </div>
      ) : (
        <div class="blog-empty">
          <p>Próximamente se publicarán nuevos artículos técnicos.</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .breadcrumb {
    background: rgba(15, 27, 61, 0.02);
    border-bottom: 1px solid rgba(15, 27, 61, 0.06);
    padding: 0.75rem 0;
  }
  .breadcrumb-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .breadcrumb-link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-ink-400);
    text-decoration: none;
    transition: color var(--motion-duration-micro);
  }
  .breadcrumb-link:hover {
    color: var(--color-navy-800);
  }
  .breadcrumb-sep {
    color: var(--color-ink-400);
    font-size: 0.75rem;
  }
  .breadcrumb-current {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-navy-800);
    font-weight: 500;
  }

  .blog-hero {
    background: linear-gradient(135deg, var(--color-navy-950) 0%, var(--color-navy-800) 100%);
    color: var(--color-white);
    padding: 4rem 0;
  }
  .blog-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .blog-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .blog-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.65;
    max-width: 42rem;
  }

  .blog-main {
    padding: 4rem 0 5rem;
    background: rgba(15, 27, 61, 0.02);
  }
  .blog-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .post-card {
    background: var(--color-white);
    border: 1px solid rgba(15, 27, 61, 0.1);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform var(--motion-duration-micro) var(--motion-ease-micro),
      box-shadow var(--motion-duration-micro) var(--motion-ease-micro),
      border-color var(--motion-duration-micro) var(--motion-ease-micro);
    opacity: 0;
    transform: translateY(1rem);
    animation: cardReveal var(--motion-duration-enter) var(--motion-ease-enter)
      calc(var(--card-index) * 60ms) forwards paused;
  }

  .blog-grid.in-view .post-card {
    animation-play-state: running;
  }

  /* Stretched link: toda la card es clickeable */
  .post-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .post-card-link:focus-visible {
    outline: 2px solid var(--color-terracotta-600);
    outline-offset: 2px;
    border-radius: var(--radius-card);
  }

  /* Estado táctil (mobile): escala sutil al presionar */
  .post-card-link:active .post-card {
    transform: scale(0.98);
    transition: transform var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(15, 27, 61, 0.16);
    border-color: rgba(15, 27, 61, 0.24);
  }

  .post-card:focus-visible {
    outline: 2px solid var(--color-terracotta-600);
    outline-offset: 2px;
  }

  .post-cover-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-navy-950);
  }

  .post-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .post-card:hover .post-cover-img {
    transform: scale(1.03);
  }

  .post-card-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .post-category {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-terracotta-600);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(181, 98, 44, 0.08);
    padding: 0.25rem 0.625rem;
    border-radius: 0.25rem;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-400);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-navy-800);
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .post-resumen {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-ink-600);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .post-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(15, 27, 61, 0.06);
  }

  .post-read-more {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-terracotta-600);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition:
      color var(--motion-duration-micro) var(--motion-ease-micro),
      transform var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .post-card:hover .post-read-more {
    color: var(--color-terracotta-500);
    transform: translateX(0.25rem);
  }

  .blog-empty {
    text-align: center;
    padding: 4rem 2rem;
    font-family: var(--font-body);
    color: var(--color-ink-600);
  }

  @media (max-width: 992px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }

  @keyframes cardReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  /*
   * IntersectionObserver para animación de entrada escalonada en .blog-grid.
   * Patrón idéntico a StatBar.astro / index.astro.
   * Stagger via --card-index (60ms por card).
   * Respeta prefers-reduced-motion.
   */
  (function () {
    const grid = document.querySelector('.blog-grid');
    if (!grid) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      grid.classList.add('in-view');
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            // once: true — desconectar tras la primera activación.
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    observer.observe(grid);
  })();
</script>

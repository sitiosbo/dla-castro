---
// ELEMENTO DE FIRMA DEL SITIO (ver tokens.css). Ruta Crítica del Reclamo, 4 fases.
// Estilo "expediente legal anotado": línea de tiempo horizontal en desktop,
// vertical en mobile. Referencias normativas (Art. 1028 Cód. Comercio) en --font-mono
// como anotación al margen, no como texto de párrafo.
// Contenido fuente: content/servicios/impugnacion-de-rechazos.md
interface Fase {
  numero: number;
  titulo: string;
  descripcion: string;
  anotacion?: string; // referencia normativa en font-mono
  cta?: { label: string; href: string };
}
interface Props {
  fases: Fase[];
}
const { fases } = Astro.props;
---

<section class="timeline-section" aria-label="Ruta Crítica del Reclamo de Seguro">
  <div class="timeline-inner">
    <!-- Encabezado de sección -->
    <div class="timeline-header">
      <p class="timeline-eyebrow">Metodología DLA</p>
      <h2 class="timeline-title">Ruta Crítica del Reclamo</h2>
      <p class="timeline-subtitle">
        Cuatro fases de defensa técnica desde el aviso de siniestro hasta el cobro
        de la indemnización. Cada etapa está documentada y respaldada por normativa vigente.
      </p>
    </div>

    <!-- Timeline horizontal desktop / vertical mobile -->
    <div class="timeline-track" role="list">
      {fases.map((fase, index) => (
        <div
          class="timeline-step"
          role="listitem"
          style={`--step-index: ${index};`}
        >
          <!-- Número de fase — "pill" de expediente -->
          <div class="step-header">
            <div class="step-number-wrap" aria-hidden="true">
              <span class="step-numero-label">FASE</span>
              <span class="step-numero">{String(fase.numero).padStart(2, '0')}</span>
            </div>
            <!-- Conector horizontal desktop (pasos 1, 2 y 3) -->
            {index < fases.length - 1 && (
              <div class="step-connector-desktop" aria-hidden="true"></div>
            )}
            <!-- Conector vertical mobile -->
            {index < fases.length - 1 && (
              <div class="step-connector-mobile" aria-hidden="true"></div>
            )}
          </div>

          <!-- Contenido del paso -->
          <div class="step-body">
            <h3 class="step-titulo">{fase.titulo}</h3>
            <p class="step-descripcion">{fase.descripcion}</p>

            {/* Anotación normativa — font-mono, estilo margen de expediente */}
            {fase.anotacion && (
              <span class="step-anotacion" aria-label={`Referencia normativa: ${fase.anotacion}`}>
                {fase.anotacion}
              </span>
            )}

            {fase.cta && (
              <a href={fase.cta.href} class="step-cta">
                {fase.cta.label}
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Nota al pie del timeline -->
    <div class="timeline-footnote">
      <span class="footnote-icon" aria-hidden="true">⚖</span>
      <p class="footnote-text">
        DLA acompaña cada fase del proceso con análisis técnico de la póliza,
        verificación de liquidaciones y representación formal ante la APS.
        <!-- TODO: validar con el abogado los plazos exactos de cada fase -->
      </p>
    </div>
  </div>
</section>

<style>
  /*
    ÚNICO componente que usa --motion-duration-orquestado (ver tokens.css y ESTADO.md 4.5).
    Secuencia orquestada: fases se revelan en cascada (150ms stagger),
    líneas conectoras se dibujan entre cada par (75ms offset).
    Total ~600ms. Gated por .timeline-visible (IntersectionObserver en JS).
  */

  .timeline-section {
    background: var(--color-white);
    padding: 5rem 0;
    position: relative;
  }

  .timeline-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Encabezado */
  .timeline-header {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 4rem;
  }

  .timeline-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-terracotta-600);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 700;
    color: var(--color-navy-800);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .timeline-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-600);
    line-height: 1.7;
  }

  /* Track del timeline */
  .timeline-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  /* Paso individual — animación gated por .timeline-visible (E1 observer) */
  .timeline-step {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;

    opacity: 0;
    transform: translateY(1.5rem);
    animation: timelineReveal 300ms var(--motion-ease-enter)
      calc(var(--step-index) * 150ms) both paused;
  }

  .timeline-visible .timeline-step {
    animation-play-state: running;
  }

  @keyframes timelineReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .step-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    position: relative;
  }

  /* Número de fase: estilo "sello de expediente" */
  .step-number-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-navy-950);
    color: var(--color-white);
    border-radius: 0.375rem;
    width: 4rem;
    height: 4rem;
    justify-content: center;
    gap: 1px;
    position: relative;
    z-index: 1;
    box-shadow: 0 2px 8px rgba(15, 27, 61, 0.25);
    transition:
      background-color var(--motion-duration-micro) var(--motion-ease-micro),
      transform var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .timeline-step:hover .step-number-wrap {
    background: var(--color-terracotta-600);
    transform: translateY(-2px);
  }

  /*
    Línea conectora horizontal desktop:
    Posicionada respecto a .timeline-step (position: relative).
    Nace bajo el centro del cuadrado de esta columna (left: 2rem) y se extiende
    hasta el centro del cuadrado de la siguiente columna (right: -4rem = 100% + gap + 2rem).
    Como los cuadrados (.step-number-wrap) tienen z-index: 1 y fondo sólido navy-950,
    la línea (z-index: 0) queda oculta debajo de los cuadrados y se muestra CONTINUA
    e ININTERRUMPIDA en todo el tramo visible entre cada par de pasos en cualquier viewport.
  */
  .step-connector-desktop {
    position: absolute;
    top: 2rem;
    left: 2rem;
    right: -4rem;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-terracotta-600) 0%,
      rgba(181, 98, 44, 0.3) 100%
    );
    pointer-events: none;
    z-index: 0;
    transform: scaleX(0) translateY(-50%);
    transform-origin: left center;
    animation: connectorDraw 200ms var(--motion-ease-enter)
      calc(var(--step-index) * 150ms + 75ms) both paused;
  }

  .timeline-visible .step-connector-desktop {
    animation-play-state: running;
  }

  @keyframes connectorDraw {
    to {
      transform: scaleX(1) translateY(-50%);
    }
  }

  .step-numero-label {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
  }

  .step-numero {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-white);
    line-height: 1;
  }

  /* Conector vertical en mobile */
  .step-connector-mobile {
    display: none;
    width: 2px;
    height: 1.5rem;
    background: linear-gradient(
      180deg,
      var(--color-terracotta-600) 0%,
      rgba(181, 98, 44, 0.3) 100%
    );
    margin-left: 1.9375rem; /* centrado bajo el número */
    transform: scaleY(0);
    transform-origin: top center;
    animation: connectorDrawMobile 200ms var(--motion-ease-enter)
      calc(var(--step-index) * 150ms + 75ms) both paused;
  }

  .timeline-visible .step-connector-mobile {
    animation-play-state: running;
  }

  @keyframes connectorDrawMobile {
    to {
      transform: scaleY(1);
    }
  }

  /* Contenido del paso */
  .step-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .step-titulo {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-navy-800);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .step-descripcion {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-ink-600);
    line-height: 1.6;
  }

  /* Anotación normativa — estilo "margen de expediente" */
  .step-anotacion {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-terracotta-600);
    background: rgba(181, 98, 44, 0.06);
    border-left: 2px solid var(--color-terracotta-600);
    padding: 0.25rem 0.5rem;
    border-radius: 0 0.25rem 0.25rem 0;
    margin-top: 0.25rem;
    letter-spacing: 0.01em;
    opacity: 0;
    animation: anotacionFade 200ms var(--motion-ease-enter)
      calc(var(--step-index) * 150ms + 100ms) both paused;
  }

  .timeline-visible .step-anotacion {
    animation-play-state: running;
  }

  @keyframes anotacionFade {
    to {
      opacity: 1;
    }
  }

  .step-cta {
    display: inline-flex;
    align-items: center;
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-terracotta-600);
    text-decoration: none;
    transition: color var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .step-cta:hover {
    color: var(--color-terracotta-500);
  }

  /* Nota al pie */
  .timeline-footnote {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    background: rgba(15, 27, 61, 0.03);
    border-radius: var(--radius-card);
    border: 1px solid rgba(15, 27, 61, 0.07);
  }

  .footnote-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
    color: var(--color-navy-600);
    margin-top: 0.1rem;
  }

  .footnote-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-ink-600);
    line-height: 1.6;
  }

  /* Responsive mobile — timeline vertical */
  @media (max-width: 900px) {
    .timeline-track {
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* Ocultar la línea horizontal en mobile */
    .step-connector-desktop {
      display: none;
    }

    .timeline-step {
      flex-direction: row;
      gap: 1.25rem;
      padding-bottom: 2rem;
    }

    .step-header {
      align-items: center;
      flex-shrink: 0;
    }

    .step-connector-mobile {
      display: block;
    }

    .step-body {
      padding-top: 0.25rem;
    }
  }

  @media (max-width: 540px) {
    .timeline-step {
      flex-direction: column;
      padding-bottom: 2rem;
      border-bottom: 1px solid rgba(15, 27, 61, 0.06);
    }

    .timeline-step:last-child {
      border-bottom: none;
    }

    .step-connector-mobile {
      display: none;
    }
  }

  /* Reduced motion: reveal instantly, no transform animation */
  @media (prefers-reduced-motion: reduce) {
    .timeline-step {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .step-connector-desktop {
      animation: none;
      transform: scaleX(1) translateY(-50%);
    }

    .step-connector-mobile {
      animation: none;
      transform: scaleY(1);
    }

    .step-anotacion {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  (function () {
    const section = document.querySelector('.timeline-section');
    if (!section) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      section.classList.add('timeline-visible');
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add('timeline-visible');
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );

    observer.observe(section);
  })();
</script>

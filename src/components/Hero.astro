---
// Hero de Home. Fondo gradiente navy-950 -> navy-800 (igual al deck original).
// Badge cream-100 "Abogado Especialista en Seguros | Bolivia".
// Wordmark DLA dominante, tagline "Defensa Legal del Asegurado" subordinado.
// H1 + subhead (25 años, asesoría estratégica, patrocinio en siniestros).
// CTA primario terracotta-600 "Agenda tu evaluación legal" + CTA secundario WhatsApp.
interface Props {
  aniosExperiencia: number;
  recuperoIndemnizaciones: number;
  arreglosDirectos: number;
}
const { aniosExperiencia, recuperoIndemnizaciones, arreglosDirectos } = Astro.props;
---

<section class="hero" aria-label="Presentación DLA — Defensa Legal del Asegurado">
  <!-- Patrón de fondo sutil: líneas diagonales tipo "expediente" -->
  <div class="hero-bg-pattern" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-content">
      <!-- Badge de autoridad -->
      <div class="hero-badge" aria-label="Especialidad">
        <span class="badge-dot" aria-hidden="true"></span>
        Abogado Especialista en Seguros · Bolivia
      </div>

      <!-- Wordmark DLA — elemento dominante -->
      <div class="hero-wordmark" aria-label="DLA — Defensa Legal del Asegurado">
        <span class="wordmark-dla">DLA</span>
        <span class="wordmark-separator" aria-hidden="true">—</span>
        <span class="wordmark-name">Defensa Legal del Asegurado</span>
      </div>

      <!-- H1 principal -->
      <h1 class="hero-h1">
        Su reclamo tiene
        <em class="hero-h1-em">derechos.</em>
        <br />
        Nosotros los defendemos.
      </h1>

      <!-- Subhead -->
      <p class="hero-subhead">
        Más de <strong class="hero-stat">{aniosExperiencia}+ años</strong> de experiencia
        especializada en Derecho de Seguros. Asesoría estratégica, patrocinio
        en siniestros e impugnación de rechazos ante aseguradoras y la APS.
      </p>

      <!-- CTAs -->
      <div class="hero-ctas">
        <a href="/contacto/" id="hero-cta-primary" class="btn-primary">
          Agenda tu evaluación legal
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="/areas-de-practica/impugnacion-de-rechazos/"
          id="hero-cta-secondary"
          class="btn-secondary"
        >
          Siniestro rechazado →
        </a>
      </div>
    </div>

    <!-- Panel derecho con stats -->
    <div class="hero-stats-panel" aria-label="Indicadores clave de efectividad">
      <div class="stats-panel-inner">
        <p class="stats-panel-label">Efectividad comprobada</p>
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-number">{recuperoIndemnizaciones}%</span>
            <span class="stat-desc">Recupero de indemnizaciones</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{arreglosDirectos}%</span>
            <span class="stat-desc">Arreglos directos pre-litigio</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">{aniosExperiencia}+</span>
            <span class="stat-desc">Años de especialización</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">4</span>
            <span class="stat-desc">Ramos especializados</span>
          </div>
        </div>
        <div class="stats-panel-footer">
          <span class="stats-panel-areas-label">Áreas con mayor intención de conversión:</span>
          <a href="/areas-de-practica/impugnacion-de-rechazos/" class="stats-panel-link-highlight">
            Impugnación de Rechazos →
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Ola de transición al siguiente bloque -->
  <div class="hero-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 60H1440V20C1200 55 960 60 720 45C480 30 240 0 0 20V60Z" fill="white"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(135deg, var(--color-navy-950) 0%, var(--color-navy-800) 100%);
    color: var(--color-white);
    padding: 5rem 0 4rem;
    overflow: hidden;
  }

  /* Patrón de fondo sutil: cuadrícula tipo papel de expediente */
  .hero-bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 4rem;
    align-items: center;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-cream-100);
    color: var(--color-navy-800);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.375rem 0.875rem 0.375rem 0.625rem;
    border-radius: 2rem;
    margin-bottom: 1.5rem;
    animation: fadeInUp var(--motion-duration-enter) var(--motion-ease-enter) both;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-terracotta-600);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Wordmark */
  .hero-wordmark {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    animation: fadeInUp var(--motion-duration-enter) var(--motion-ease-enter) 60ms both;
  }

  .wordmark-dla {
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .wordmark-separator {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--color-terracotta-600);
    line-height: 1;
  }

  .wordmark-name {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.01em;
    line-height: 1.3;
    max-width: 12rem;
  }

  /* H1 */
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-white);
    margin-bottom: 1.25rem;
    animation: fadeInUp var(--motion-duration-enter) var(--motion-ease-enter) 120ms both;
  }

  .hero-h1-em {
    font-style: italic;
    color: var(--color-terracotta-500);
  }

  /* Subhead */
  .hero-subhead {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.72);
    max-width: 38rem;
    margin-bottom: 2rem;
    animation: fadeInUp var(--motion-duration-enter) var(--motion-ease-enter) 180ms both;
  }

  .hero-stat {
    font-family: var(--font-mono);
    color: var(--color-terracotta-500);
    font-weight: 500;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    animation: fadeInUp var(--motion-duration-enter) var(--motion-ease-enter) 240ms both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-white);
    background: var(--color-terracotta-600);
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    transition:
      background-color var(--motion-duration-micro) var(--motion-ease-micro),
      transform var(--motion-duration-micro) var(--motion-ease-micro),
      box-shadow var(--motion-duration-micro) var(--motion-ease-micro);
    box-shadow: 0 4px 12px rgba(181, 98, 44, 0.4);
  }

  .btn-primary:hover {
    background: var(--color-terracotta-500);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(181, 98, 44, 0.55);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgba(255,255,255,0.8);
    text-decoration: none;
    padding: 0.75rem 1.25rem;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 0.5rem;
    transition:
      color var(--motion-duration-micro) var(--motion-ease-micro),
      border-color var(--motion-duration-micro) var(--motion-ease-micro),
      background var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .btn-secondary:hover {
    color: var(--color-white);
    border-color: rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.06);
  }

  /* Panel de stats */
  .hero-stats-panel {
    animation: fadeInUp var(--motion-duration-enter) var(--motion-ease-enter) 100ms both;
  }

  .stats-panel-inner {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 0.75rem;
    padding: 1.75rem;
    backdrop-filter: blur(12px);
  }

  .stats-panel-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 1.25rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-terracotta-500);
    line-height: 1;
  }

  .stat-desc {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.4;
  }

  .stats-panel-footer {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .stats-panel-areas-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.4);
  }

  .stats-panel-link-highlight {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-terracotta-500);
    text-decoration: none;
    transition: color var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .stats-panel-link-highlight:hover {
    color: var(--color-cream-100);
  }

  /* Ola de transición */
  .hero-wave {
    position: relative;
    margin-top: 3rem;
    line-height: 0;
  }

  .hero-wave svg {
    width: 100%;
    display: block;
  }

  /* Animación de entrada */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-stats-panel {
      display: none; /* En mobile el TrustBar reemplaza visualmente los stats del hero */
    }

    .wordmark-dla {
      font-size: 3.5rem;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3.5rem 0 2.5rem;
    }

    .wordmark-dla {
      font-size: 2.75rem;
    }
  }
</style>

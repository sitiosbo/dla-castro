---
// Barra de confianza inmediata post-hero: 25+ años / % recupero / ciudades de cobertura.
// Aquí es donde "Castro" aparece por primera vez como firma/credencial (no como marca).
// Datos vienen de content/settings/general.json.
// Count-up: IntersectionObserver + --motion-duration-countup (mismo patrón que StatBar.astro).
import { getEntry } from 'astro:content';
const settings = await getEntry('settings', 'general');
const { aniosExperiencia, recuperoIndemnizaciones, arreglosDirectos } = settings.data.stats;
const { ciudadesCobertura } = settings.data.contacto;

const items = [
  {
    countTo: aniosExperiencia,
    suffix: '+',
    label: 'Años de experiencia',
    sublabel: 'en Derecho de Seguros',
    mono: true,
  },
  {
    countTo: recuperoIndemnizaciones,
    suffix: '%',
    label: 'Recupero de indemnizaciones',
    sublabel: 'casos complejos',
    mono: true,
  },
  {
    countTo: arreglosDirectos,
    suffix: '%',
    label: 'Arreglos directos',
    sublabel: 'sin llegar a juicio',
    mono: true,
  },
  {
    cities: ciudadesCobertura.slice(0, -1),
    label: 'Cobertura nacional',
    sublabel: 'Bolivia',
    isCity: true,
  },
];
---

<section class="trustbar" aria-label="Indicadores de confianza DLA">
  <!-- Numeral gigante traslúcido de fondo (marca de agua editorial) -->
  <span class="trustbar-watermark" aria-hidden="true">{aniosExperiencia}+</span>
  <div class="trustbar-inner">
    <div class="trustbar-items">
      {items.map((item) => (
        <div class="trustbar-item">
          {item.countTo !== undefined ? (
            <span class:list={['trustbar-value', { 'trustbar-value-mono': item.mono }]}>
              <span class="trustbar-count" data-count-to={item.countTo} data-count-suffix={item.suffix}>0</span>
              <span class="trustbar-suffix">{item.suffix}</span>
            </span>
          ) : (
            <ul class="trustbar-cities">
              {item.cities.map((city: string) => (
                <li>{city}</li>
              ))}
            </ul>
          )}
          <span class="trustbar-label">{item.label}</span>
          <span class="trustbar-sublabel">{item.sublabel}</span>
        </div>
      ))}
    </div>

    <!-- Primera mención de Castro: solo como firma del abogado responsable -->
    <div class="trustbar-firma">
      <span class="trustbar-firma-text">
        Abogado responsable:
        <a href="/sobre-mi/" class="trustbar-firma-link">Ramiro Guillermo Castro</a>
      </span>
      <span class="trustbar-firma-sep" aria-hidden="true">·</span>
      <span class="trustbar-firma-text">
        Especialista en Derecho de Seguros en Bolivia
      </span>
    </div>
  </div>
</section>

<style>
  .trustbar {
    position: relative;
    overflow: hidden;
    background: var(--color-white);
    border-bottom: 1px solid rgba(15, 27, 61, 0.07);
    padding: 2.5rem 0;
  }

  .trustbar-watermark {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: 11rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-navy-800);
    opacity: 0.04;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .trustbar-inner {
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .trustbar-items {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(15, 27, 61, 0.20);
    border: 1px solid rgba(15, 27, 61, 0.20);
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15, 27, 61, 0.05);
    min-width: 0;
  }

  .trustbar-item {
    background: var(--color-white);
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    overflow-wrap: break-word;
    word-wrap: break-word;
    min-width: 0;
    transition: background-color var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .trustbar-item:hover {
    background: rgba(15, 27, 61, 0.02);
  }

  /* Celda de ciudades — desacoplada de las celdas numéricas */
  .trustbar-cities {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .trustbar-cities li {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-navy-800);
    line-height: 1.5;
  }

  .trustbar-value {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-navy-800);
    line-height: 1;
    letter-spacing: -0.02em;
    display: flex;
    align-items: baseline;
  }

  .trustbar-value-mono {
    font-family: var(--font-mono);
    font-size: 3rem;
    color: var(--color-terracotta-600);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* Contador numérico: tabular-nums evita CLS durante la animación */
  .trustbar-count {
    font-variant-numeric: tabular-nums;
    min-width: 2ch;
    display: inline-block;
  }

  .trustbar-suffix {
    font-variant-numeric: tabular-nums;
  }

  .trustbar-label {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-navy-800);
    margin-top: 0.25rem;
  }

  .trustbar-sublabel {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-ink-400);
  }

  /* Firma del abogado — Castro como credencial, no como co-marca */
  .trustbar-firma {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .trustbar-firma-text {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-ink-400);
  }

  /* Castro: enlace sutil, mismo tamaño que el texto acompañante — nunca jerarquía de marca */
  .trustbar-firma-link {
    color: var(--color-ink-600);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(74, 85, 104, 0.3);
    transition: color var(--motion-duration-micro) var(--motion-ease-micro),
                border-color var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .trustbar-firma-link:hover {
    color: var(--color-navy-800);
    border-color: var(--color-navy-800);
  }

  .trustbar-firma-sep {
    color: var(--color-ink-400);
    font-size: 0.75rem;
  }

  @media (max-width: 900px) {
    .trustbar-items {
      grid-template-columns: 1fr 1fr;
    }

    .trustbar-value,
    .trustbar-value-mono {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 540px) {
    .trustbar-items {
      grid-template-columns: 1fr;
    }

    .trustbar-item {
      padding: 1.5rem 1.25rem;
    }

    .trustbar-value,
    .trustbar-value-mono {
      font-size: 2.25rem;
    }

    .trustbar-firma {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .trustbar-firma-sep {
      display: none;
    }
  }
</style>

<script>
  /*
   * Count-up animado para los números del TrustBar.
   * Mismo patrón que StatBar.astro: IntersectionObserver + prefers-reduced-motion.
   * Usa --motion-duration-countup de tokens.css como duración base.
   * Easing: ease-out cuadrático (rápido al inicio, suave al final — natural para conteo).
   * Se dispara una sola vez por carga de página (observer.disconnect() tras primera activación).
   */
  (function () {
    const bar = document.querySelector('.trustbar-items');
    if (!bar) return;
    
    const countEls = bar.querySelectorAll<HTMLElement>('[data-count-to]');
    if (countEls.length === 0) return;

    // Duración desde tokens.css — fallback 1200ms si la variable no está cargada
    const rootStyles = getComputedStyle(document.documentElement);
    const rawDuration = rootStyles.getPropertyValue('--motion-duration-countup').trim();
    const duration = rawDuration ? Math.round(parseFloat(rawDuration) * (rawDuration.endsWith('ms') ? 1 : 1000)) : 1200;

    // prefers-reduced-motion: mostrar valores finales sin animar
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      countEls.forEach((el) => {
        const target = parseInt(el.dataset.countTo!, 10);
        el.textContent = `${target}`;
      });
      return;
    }

    // Easing: ease-out cuadrático — rápido al inicio, suave al final
    function easeOutQuad(t: number): number {
      return 1 - (1 - t) * (1 - t);
    }

    function animateCount(el: HTMLElement) {
      const target = parseInt(el.dataset.countTo!, 10);
      const start = performance.now();
      
      function tick(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const easedProgress = easeOutQuad(progress);
        const current = Math.round(easedProgress * target);
        el.textContent = `${current}`;

        if (progress < 1) {
          requestAnimationFrame(tick);
        }
      }

      requestAnimationFrame(tick);
    }

    // IntersectionObserver — se activa una sola vez (same pattern que StatBar.astro)
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            countEls.forEach((el) => animateCount(el));
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );

    observer.observe(bar);
  })();
</script>

---
// Gráfico de barras "Efectividad en Reclamos Complejos" (88/82/79/95%).
// Usar --font-mono para los porcentajes (refuerza ángulo técnico-regulatorio).
// Reutilizable: recibe array de {label, value, colorToken}.
interface Stat {
  label: string;
  value: number;
}
interface Props {
  stats: Stat[];
  title?: string;
  subtitle?: string;
}
const {
  stats,
  title = 'Efectividad en Reclamos Complejos',
  subtitle = 'Resultados históricos del estudio en los principales ramos del mercado asegurador boliviano.',
} = Astro.props;

// Calcular ancho máximo para la barra (baseline: 100% = el valor mayor)
const maxValue = Math.max(...stats.map((s) => s.value));
---

<section class="statbar-section" aria-label="Indicadores de efectividad DLA">
  <!-- Numeral gigante traslúcido de fondo (marca de agua editorial) -->
  <span class="statbar-watermark" aria-hidden="true">{maxValue}%</span>
  <div class="statbar-inner">
    <div class="statbar-header">
      <p class="statbar-eyebrow">Datos verificables</p>
      <h2 class="statbar-title">{title}</h2>
      <p class="statbar-subtitle">{subtitle}</p>
    </div>

    <div class="statbar-chart" role="list">
      {stats.map((stat, index) => {
        const barWidth = (stat.value / maxValue) * 100;
        return (
          <div
            class="statbar-row"
            role="listitem"
            style={`--bar-index: ${index}; --bar-width: ${barWidth}%; --bar-value: ${stat.value}`}
          >
            <div class="statbar-label-wrap">
              <span class="statbar-label">{stat.label}</span>
            </div>
            <div class="statbar-bar-wrap" aria-hidden="true">
              <div class="statbar-bar">
                <div class="statbar-bar-fill"></div>
              </div>
            </div>
            <span
              class="statbar-value"
              aria-label={`${stat.value} por ciento`}
            >
              {stat.value}<span class="statbar-pct">%</span>
            </span>
          </div>
        );
      })}
    </div>

    <p class="statbar-disclaimer">
      * Porcentajes calculados sobre el total de casos cerrados en cada categoría.
      Resultados históricos, no garantizan resultados futuros.
      <!-- TODO: validar con el abogado la redacción exacta del disclaimer -->
    </p>
  </div>
</section>

<style>
  .statbar-section {
    position: relative;
    overflow: hidden;
    background: rgba(15, 27, 61, 0.02);
    border-top: 1px solid rgba(15, 27, 61, 0.06);
    border-bottom: 1px solid rgba(15, 27, 61, 0.06);
    padding: 4.5rem 0;
  }

  .statbar-watermark {
    position: absolute;
    right: 3rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: 14rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-navy-800);
    opacity: 0.04;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .statbar-inner {
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Encabezado */
  .statbar-header {
    max-width: 38rem;
    margin-bottom: 3rem;
  }

  .statbar-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-terracotta-600);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }

  .statbar-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--color-navy-800);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .statbar-subtitle {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-ink-600);
    line-height: 1.6;
  }

  /* Gráfico de barras */
  .statbar-chart {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .statbar-row {
    display: grid;
    grid-template-columns: 14rem 1fr 4rem;
    gap: 1rem;
    align-items: center;
    opacity: 0;
    transform: translateX(-1rem);
    /*
      animation-play-state: paused por defecto.
      Se cambia a running SOLO cuando el padre (.statbar-chart) recibe .in-view
      mediante IntersectionObserver — garantiza que el usuario vea la animación
      al hacer scroll, no al cargar la página fuera del viewport.
    */
    animation: barReveal var(--motion-duration-enter) var(--motion-ease-enter)
      calc(var(--bar-index) * 80ms) forwards paused;
  }

  .statbar-chart.in-view .statbar-row {
    animation-play-state: running;
  }

  @keyframes barReveal {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .statbar-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-navy-800);
    line-height: 1.3;
  }

  .statbar-bar-wrap {
    display: flex;
    align-items: center;
  }

  .statbar-bar {
    width: 100%;
    height: 0.75rem;
    background: rgba(15, 27, 61, 0.06);
    border-radius: 0.375rem;
    overflow: hidden;
  }

  .statbar-bar-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(
      90deg,
      var(--color-terracotta-600) 0%,
      var(--color-terracotta-500) 100%
    );
    border-radius: 0.375rem;
    /* paused por defecto, running cuando el padre tiene .in-view */
    animation: growBar 0.8s var(--motion-ease-enter)
      calc(var(--bar-index) * 80ms + 200ms) forwards paused;
  }

  .statbar-chart.in-view .statbar-bar-fill {
    animation-play-state: running;
  }

  @keyframes growBar {
    from { width: 0; }
    to { width: var(--bar-width); }
  }

  .statbar-value {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-terracotta-600);
    text-align: right;
    line-height: 1;
  }

  .statbar-pct {
    font-size: 0.875rem;
    font-weight: 400;
  }

  /* Disclaimer */
  .statbar-disclaimer {
    margin-top: 2rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-ink-400);
    line-height: 1.5;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(15, 27, 61, 0.06);
  }

  @media (max-width: 640px) {
    .statbar-row {
      grid-template-columns: 1fr 3rem;
      grid-template-rows: auto auto;
      gap: 0.375rem 0.75rem;
    }

    .statbar-label-wrap {
      grid-column: 1;
      grid-row: 1;
    }

    .statbar-value {
      grid-column: 2;
      grid-row: 1;
      text-align: right;
    }

    .statbar-bar-wrap {
      grid-column: 1 / 3;
      grid-row: 2;
    }
  }
</style>

<script>
  /*
   * IntersectionObserver para StatBar.
   * Agrega .in-view al .statbar-chart cuando entra en el viewport (threshold 0.3).
   * { once: true }: se desconecta inmediatamente tras la primera activación.
   * El usuario ve las barras crecer al hacer scroll, no al cargar la página.
   * No introduce valores de timing nuevos: usa los --motion-* ya definidos en tokens.css.
   */
  (function () {
    const chart = document.querySelector('.statbar-chart');
    if (!chart) return;

    // Respect prefers-reduced-motion: si el usuario pide menos movimiento,
    // activar directamente sin animar.
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      chart.classList.add('in-view');
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            chart.classList.add('in-view');
            // once: true — desconectar tras la primera activación.
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );

    observer.observe(chart);
  })();
</script>

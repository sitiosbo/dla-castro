---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  badge?: string;
  badgeDot?: boolean;
}

const { eyebrow, title, subtitle, badge, badgeDot } = Astro.props;
---

<header class="page-hero">
  <div class="page-hero-inner">
    {badge && (
      <div class="page-hero-badge">
        {badgeDot && <span class="page-hero-badge-dot"></span>}
        {badge}
      </div>
    )}
    {eyebrow && <p class="eyebrow page-hero-eyebrow">{eyebrow}</p>}
    <h1 class="page-hero-title">{title}</h1>
    {subtitle && <p class="page-hero-subtitle">{subtitle}</p>}
    <slot />
  </div>
</header>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-navy-950) 0%, var(--color-navy-800) 100%);
    color: var(--color-white);
    padding: 4rem 0;
    overflow: hidden;
  }

  .page-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-hero-badge,
  .page-hero-eyebrow,
  .page-hero-title,
  .page-hero-subtitle {
    opacity: 0;
    transform: translateX(-28px);
    animation: pageHeroIn 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .page-hero-badge { animation-delay: 0ms; }
  .page-hero-eyebrow { animation-delay: 0ms; }
  .page-hero-title { animation-delay: 180ms; }
  .page-hero-subtitle { animation-delay: 360ms; }

  .page-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-cream-100);
    color: var(--color-navy-800);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.375rem 0.875rem;
    border-radius: 2rem;
    margin-bottom: 1.25rem;
  }

  .page-hero-badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-terracotta-600);
    border-radius: 50%;
  }

  .page-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .page-hero-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.65;
    max-width: 40rem;
  }

  @keyframes pageHeroIn {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero-badge,
    .page-hero-eyebrow,
    .page-hero-title,
    .page-hero-subtitle {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

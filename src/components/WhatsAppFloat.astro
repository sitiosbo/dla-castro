---
// Botón flotante de WhatsApp, persistente en TODAS las páginas (ver BaseLayout).
// Número desde content/settings/general.json (contacto.whatsapp).
// Mensaje predefinido varía según página de origen si es posible
// (ej. en /areas-de-practica/impugnacion-de-rechazos/ el mensaje precargado
// menciona "rechazo de siniestro" para reducir fricción).
import { getEntry } from 'astro:content';
const settings = await getEntry('settings', 'general');
const whatsappNumber = settings.data.contacto.whatsapp;

const currentPath = Astro.url.pathname;

// Mensajes contextuales por sección de origen
function getContextualMessage(path: string): string {
  if (path.includes('impugnacion-de-rechazos')) {
    return 'Hola, tengo un siniestro rechazado y necesito asesoría urgente.';
  }
  if (path.includes('seguros-generales')) {
    return 'Hola, necesito asesoría legal en seguros generales/patrimoniales.';
  }
  if (path.includes('seguros-de-personas')) {
    return 'Hola, necesito asesoría en seguros de vida/salud/accidentes.';
  }
  if (path.includes('fianzas-y-caucion')) {
    return 'Hola, necesito asesoría en fianzas y garantías contractuales.';
  }
  if (path.includes('contacto')) {
    return 'Hola, quiero agendar una evaluación legal inicial con DLA.';
  }
  return 'Hola, me interesa una evaluación legal inicial con DLA — Defensa Legal del Asegurado.';
}

const message = getContextualMessage(currentPath);
const encodedMessage = encodeURIComponent(message);

// Si el número es el placeholder, no renderizar el botón para no generar URL inválida
const isPlaceholder = whatsappNumber === 'TODO_NUMERO_WHATSAPP' || !whatsappNumber;
const waUrl = isPlaceholder
  ? '#'
  : `https://wa.me/${whatsappNumber.replace(/\D/g, '')}?text=${encodedMessage}`;
---

{!isPlaceholder ? (
  <a
    href={waUrl}
    id="whatsapp-float"
    class="whatsapp-float"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp — DLA Defensa Legal del Asegurado"
    title="Consulta por WhatsApp"
  >
    <!-- Icono WhatsApp SVG: mantiene color verde #25D366 sobre fondo navy --
         El verde se contiene en el ícono (reconocimiento universal de WhatsApp),
         no en el fondo del botón (que ahora sigue la paleta DLA). -->
    <svg
      class="wa-icon"
      viewBox="0 0 24 24"
      fill="#25D366"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    <span class="wa-label">WhatsApp</span>
  </a>
) : (
  <!-- WhatsApp: número pendiente — TODO_NUMERO_WHATSAPP en settings/general.json -->
  <div id="whatsapp-float-placeholder" class="whatsapp-float whatsapp-float-placeholder" title="WhatsApp — número pendiente de configurar">
    <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    <span class="wa-label">WhatsApp</span>
  </div>
)}

<style>
  /*
   * Botón flotante WhatsApp.
   * Fondo: var(--color-navy-800) — integrado en la paleta DLA.
   * Ícono SVG: fill #25D366 explícito — el verde WhatsApp vive en el ícono,
   * no en el fondo del botón. Preserva el reconocimiento universal.
   */
  .whatsapp-float {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-navy-800);
    color: var(--color-white);
    text-decoration: none;
    padding: 0.75rem 1.125rem 0.75rem 0.875rem;
    border-radius: 3rem;
    /* Sombra del sistema DLA (navy), no sombra verde saturada */
    box-shadow: var(--shadow-card), 0 4px 16px rgba(15, 27, 61, 0.25);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      transform var(--motion-duration-micro) var(--motion-ease-micro),
      box-shadow var(--motion-duration-micro) var(--motion-ease-micro),
      background-color var(--motion-duration-micro) var(--motion-ease-micro);
  }

  /* Hover: feedback táctil con translateY + sombra más profunda navy.
     NO vira el fondo a verde — mantiene la paleta DLA. */
  .whatsapp-float:hover {
    background: var(--color-navy-950);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card), 0 8px 24px rgba(15, 27, 61, 0.35);
  }

  .whatsapp-float-placeholder {
    opacity: 0.6;
    cursor: default;
  }

  .wa-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .wa-label {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .whatsapp-float {
      bottom: 1rem;
      right: 1rem;
      padding: 0.875rem;
      border-radius: 50%;
    }

    .wa-label {
      display: none;
    }
  }
</style>

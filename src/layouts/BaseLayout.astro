---
// BaseLayout: envoltorio de toda página. Carga tokens.css, fuentes, meta tags base,
// schema.org LegalService + Person (ver ESTADO.md sección SEO/AEO/GEO).
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Toast from '../components/Toast.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { direccionSchema } from '../data/oficina';
import { siteUrl } from '../data/site';
import '../styles/tokens.css';

// Fuentes autoalojadas (Fontsource) — sin peticiones externas a Google Fonts
// Fraunces: variante /opsz conserva el eje óptico 9..144 (opsz+wght) que usa el Hero
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

interface Props {
  title: string;
  description: string;
  // schemaExtra: JSON-LD adicional por página (FAQPage, BreadcrumbList, BlogPosting)
  // Puede ser un objeto único o un array de objetos
  schemaExtra?: Record<string, unknown> | Record<string, unknown>[];
  canonical?: string;
  ogImage?: string;
  // noindex: páginas que no deben indexarse (ej. 404) → <meta name="robots">
  noindex?: boolean;
}
const {
  title,
  description,
  schemaExtra,
  canonical = Astro.url.href,
  ogImage = '/og-default.png',
  noindex = false,
} = Astro.props;

// schema.org base — LegalService (marca DLA) + Person (Castro, abogado responsable)
const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LegalService',
      '@id': `${siteUrl}/#organization`,
      name: 'DLA — Defensa Legal del Asegurado',
      url: siteUrl,
      logo: `${siteUrl}/logo-schema.png`,
      telephone: '+59157001099',
      // Dirección postal de la oficina (fuente: settings/general.json → contacto.direccion,
      // derivada en src/data/oficina.ts). Sin geo/openingHours: no son datos confirmados.
      address: direccionSchema,
      description:
        'Estudio jurídico especializado en Derecho de Seguros en Bolivia. Asesoría técnica, patrocinio en siniestros e impugnación de rechazos de cobertura.',
      areaServed: [
        { '@type': 'City', name: 'La Paz' },
        { '@type': 'City', name: 'Santa Cruz' },
        { '@type': 'City', name: 'Cochabamba' },
        { '@type': 'Country', name: 'Bolivia' },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Áreas de Práctica',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Seguros Generales', url: `${siteUrl}/areas-de-practica/seguros-generales/` } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Seguros de Personas', url: `${siteUrl}/areas-de-practica/seguros-de-personas/` } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Fianzas y Caución', url: `${siteUrl}/areas-de-practica/fianzas-y-caucion/` } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Impugnación de Rechazos', url: `${siteUrl}/areas-de-practica/impugnacion-de-rechazos/` } },
        ],
      },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person-castro`,
      name: 'Ramiro Guillermo Castro',
      jobTitle: 'Abogado Especialista en Derecho de Seguros',
      worksFor: { '@id': `${siteUrl}/#organization` },
      knowsAbout: ['Derecho de Seguros', 'Impugnación de rechazos', 'Ley 1883 de Bolivia', 'APS Bolivia'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'DLA — Defensa Legal del Asegurado',
      url: siteUrl,
      inLanguage: 'es-BO',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    // schemaExtra puede ser un objeto único o un array de objetos (ej. BlogPosting + BreadcrumbList)
    ...(schemaExtra
      ? (Array.isArray(schemaExtra) ? schemaExtra : [schemaExtra])
      : []),
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <!-- Google Analytics: se carga solo tras el consentimiento (ver components/CookieBanner.astro) -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · DLA — Defensa Legal del Asegurado</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={`${title} · DLA — Defensa Legal del Asegurado`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:site_name" content="DLA — Defensa Legal del Asegurado" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · DLA — Defensa Legal del Asegurado`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicon DLA — wordmark en SVG, pendiente diseño gráfico definitivo -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Fuentes autoalojadas vía Fontsource (imports en el frontmatter de este archivo) -->

    <!-- schema.org JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="font-body text-ink-600">
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <Toast />
    <CookieBanner />
  </body>
</html>

<style>
  /* Spacer para header fijo — aplica a todas las páginas automáticamente */
  .site-main {
    padding-top: var(--header-height);
  }
</style>
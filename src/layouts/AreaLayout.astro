---
// AreaLayout: layout compartido para todas las páginas de área de práctica.
// Si prioridadConversion === 'alta' (impugnacion-de-rechazos), muestra CTA urgente + Timeline.
// Breadcrumb navegable para SEO.
import BaseLayout from './BaseLayout.astro';
import Timeline from '../components/Timeline.astro';

interface Props {
  titulo: string;
  resumen: string;
  slug: string;
  prioridadConversion: 'alta' | 'media';
  icono?: string;
  breadcrumbLabel: string;
  // Schema BreadcrumbList para esta subpágina
}

const { titulo, resumen, slug, prioridadConversion, breadcrumbLabel } = Astro.props;
const esUrgente = prioridadConversion === 'alta';

// Iconos SVG inline
const iconos: Record<string, string> = {
  document: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6M9 16h6M7 4H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V8l-5-4H7z"/><path d="M14 4v4h5"/></svg>`,
  heart: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
  shield: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  gavel: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22l9-9-3-3-6 6-3-3-3 3 3 3 3 3z"/><path d="M5 12L3 14l7 7 2-2M14.5 4.5l-6 6 3 3 6-6-3-3z"/></svg>`,
};

// Schema BreadcrumbList
const schemaExtra = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://dlaseguros.bo/' },
    { '@type': 'ListItem', position: 2, name: 'Áreas de Práctica', item: 'https://dlaseguros.bo/areas-de-practica/' },
    { '@type': 'ListItem', position: 3, name: breadcrumbLabel, item: `https://dlaseguros.bo/areas-de-practica/${slug}/` },
  ],
};

// Fases del timeline para impugnación (solo se muestra en esa página)
const fasesImpugnacion = [
  {
    numero: 1,
    titulo: 'Ocurrencia',
    descripcion: 'Aviso formal de siniestro y verificación de plazos legales según normativa vigente.',
    anotacion: 'Art. 1028 Cód. Comercio',
  },
  {
    numero: 2,
    titulo: 'Liquidación',
    descripcion: 'Aportación de evidencias y fiscalización técnica del informe del ajustador.',
    anotacion: 'Supervisión APS',
  },
  {
    numero: 3,
    titulo: 'Impugnación',
    descripcion: 'Presentación de reclamo formal ante rechazo u objeción en los plazos reglamentarios.',
    anotacion: 'Vía administrativa',
  },
  {
    numero: 4,
    titulo: 'Ejecución',
    descripcion: 'Cobro de indemnización o activación de la vía arbitral/judicial ante negativa persistente.',
    anotacion: 'Arbitraje · Litigio',
  },
];
---

<BaseLayout title={titulo} description={resumen} schemaExtra={schemaExtra}>
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Ruta de navegación">
    <div class="breadcrumb-inner">
      <a href="/" class="breadcrumb-link">Inicio</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <a href="/areas-de-practica/" class="breadcrumb-link">Áreas de Práctica</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span class="breadcrumb-current" aria-current="page">{breadcrumbLabel}</span>
    </div>
  </nav>

  <!-- Hero de subpágina -->
  <header class:list={['area-hero', { 'area-hero-urgente': esUrgente }]}>
    <div class="area-hero-inner">
      <div class="area-hero-content">
        {esUrgente && (
          <div class="area-urgente-badge">
            <span class="urgente-dot" aria-hidden="true"></span>
            Caso urgente — actúe en los plazos reglamentarios
          </div>
        )}
        <div class="area-hero-icon" aria-hidden="true" set:html={iconos[Astro.props.icono ?? 'document']} />
        <h1 class="area-hero-titulo">{titulo}</h1>
        <p class="area-hero-desc">{resumen}</p>

        {esUrgente ? (
          <div class="area-hero-ctas">
            <a href="/contacto/" class="btn-urgente">
              Consulta urgente — contactar ahora
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="/proceso/" class="btn-secundario-blanco">Ver proceso completo</a>
          </div>
        ) : (
          <div class="area-hero-ctas">
            <a href="/contacto/" class="btn-primary-area">Consultar este caso</a>
            <a href="/areas-de-practica/" class="btn-outline-blanco">Otras áreas</a>
          </div>
        )}
      </div>
    </div>
  </header>

  <!-- Timeline SOLO en impugnación de rechazos (CTA reforzado + arriba del fold) -->
  {esUrgente && (
    <Timeline fases={fasesImpugnacion} />
  )}

  <!-- Contenido principal de la página (slot = Content del markdown) -->
  <main class="area-main">
    <div class="area-main-inner">
      <div class="area-content prose">
        <slot />
      </div>

      <!-- Sidebar de contacto -->
      <aside class="area-sidebar">
        <div class="sidebar-card">
          <p class="sidebar-eyebrow">Consulta especializada</p>
          <h2 class="sidebar-titulo">¿Necesita asesoría en {titulo}?</h2>
          <p class="sidebar-desc">
            Evaluación inicial confidencial. Analizamos su caso y le indicamos
            la mejor estrategia de defensa.
          </p>
          <a href="/contacto/" class="sidebar-cta">
            Agenda tu evaluación legal
          </a>
          <div class="sidebar-meta">
            <span class="sidebar-meta-item">Sin compromiso</span>
            <span class="sidebar-meta-sep" aria-hidden="true">·</span>
            <span class="sidebar-meta-item">Confidencial</span>
          </div>
        </div>

        <!-- Enlace a otras áreas -->
        <div class="sidebar-otras-areas">
          <p class="sidebar-otras-titulo">Otras áreas de práctica</p>
          <a href="/areas-de-practica/seguros-generales/" class="sidebar-area-link">Seguros Generales</a>
          <a href="/areas-de-practica/seguros-de-personas/" class="sidebar-area-link">Seguros de Personas</a>
          <a href="/areas-de-practica/fianzas-y-caucion/" class="sidebar-area-link">Fianzas y Caución</a>
          <a href="/areas-de-practica/impugnacion-de-rechazos/" class="sidebar-area-link sidebar-area-link-highlight">
            Impugnación de Rechazos →
          </a>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  /* Breadcrumb */
  .breadcrumb {
    background: rgba(15, 27, 61, 0.02);
    border-bottom: 1px solid rgba(15, 27, 61, 0.06);
    padding: 0.75rem 0;
  }

  .breadcrumb-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .breadcrumb-link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-ink-400);
    text-decoration: none;
    transition: color var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .breadcrumb-link:hover { color: var(--color-navy-800); }

  .breadcrumb-sep {
    color: var(--color-ink-400);
    font-size: 0.75rem;
  }

  .breadcrumb-current {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-navy-800);
    font-weight: 500;
  }

  /* Hero de subpágina */
  .area-hero {
    background: linear-gradient(135deg, var(--color-navy-950) 0%, var(--color-navy-800) 100%);
    color: var(--color-white);
    padding: 4rem 0;
  }

  .area-hero-urgente {
    background: linear-gradient(135deg, #0A1228 0%, var(--color-navy-950) 60%, #1A0D00 100%);
  }

  .area-hero-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .area-urgente-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(181, 98, 44, 0.2);
    border: 1px solid rgba(181, 98, 44, 0.4);
    color: var(--color-terracotta-500);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.375rem 0.875rem;
    border-radius: 2rem;
    margin-bottom: 1.5rem;
  }

  .urgente-dot {
    width: 6px;
    height: 6px;
    background: var(--color-terracotta-500);
    border-radius: 50%;
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .area-hero-icon {
    color: var(--color-terracotta-500);
    margin-bottom: 1.25rem;
  }

  .area-hero-titulo {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1rem;
    max-width: 40rem;
  }

  .area-hero-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.65;
    max-width: 36rem;
    margin-bottom: 2rem;
  }

  .area-hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-urgente {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-white);
    background: var(--color-terracotta-600);
    text-decoration: none;
    padding: 0.875rem 1.75rem;
    border-radius: 0.5rem;
    box-shadow: 0 4px 16px rgba(181, 98, 44, 0.5);
    transition:
      background-color var(--motion-duration-micro) var(--motion-ease-micro),
      transform var(--motion-duration-micro) var(--motion-ease-micro),
      box-shadow var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .btn-urgente:hover {
    background: var(--color-terracotta-500);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(181, 98, 44, 0.6);
  }

  .btn-secundario-blanco,
  .btn-outline-blanco {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgba(255,255,255,0.8);
    text-decoration: none;
    padding: 0.875rem 1.5rem;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 0.5rem;
    transition:
      color var(--motion-duration-micro) var(--motion-ease-micro),
      border-color var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .btn-secundario-blanco:hover,
  .btn-outline-blanco:hover {
    color: var(--color-white);
    border-color: rgba(255,255,255,0.5);
  }

  .btn-primary-area {
    display: inline-flex;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-white);
    background: var(--color-terracotta-600);
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    transition:
      background-color var(--motion-duration-micro) var(--motion-ease-micro),
      transform var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .btn-primary-area:hover {
    background: var(--color-terracotta-500);
    transform: translateY(-1px);
  }

  /* Main + sidebar */
  .area-main {
    padding: 4rem 0 5rem;
  }

  .area-main-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 4rem;
    align-items: start;
  }

  /* Prose: estilos para el contenido markdown */
  .area-content.prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-navy-800);
    letter-spacing: -0.02em;
    margin: 2.5rem 0 1rem;
    line-height: 1.3;
  }

  .area-content.prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-navy-800);
    margin: 2rem 0 0.75rem;
  }

  .area-content.prose :global(p) {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink-600);
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .area-content.prose :global(ul) {
    list-style: none;
    padding: 0;
    margin: 1rem 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .area-content.prose :global(li) {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-ink-600);
    line-height: 1.6;
    padding-left: 1.5rem;
    position: relative;
  }

  .area-content.prose :global(li::before) {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--color-terracotta-600);
    font-weight: 700;
  }

  .area-content.prose :global(strong) {
    font-weight: 700;
    color: var(--color-navy-800);
  }

  /* Sidebar */
  .sidebar-card {
    background: var(--color-navy-950);
    color: var(--color-white);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-bottom: 1.5rem;
    position: sticky;
    top: 5rem;
  }

  .sidebar-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-terracotta-500);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .sidebar-titulo {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.3;
  }

  .sidebar-desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
  }

  .sidebar-cta {
    display: block;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-white);
    background: var(--color-terracotta-600);
    text-decoration: none;
    padding: 0.75rem;
    border-radius: 0.375rem;
    transition:
      background-color var(--motion-duration-micro) var(--motion-ease-micro),
      transform var(--motion-duration-micro) var(--motion-ease-micro);
    margin-top: 0.25rem;
  }

  .sidebar-cta:hover {
    background: var(--color-terracotta-500);
    transform: translateY(-1px);
  }

  .sidebar-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .sidebar-meta-item {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: rgba(255,255,255,0.35);
  }

  .sidebar-meta-sep {
    color: rgba(255,255,255,0.2);
    font-size: 0.6875rem;
  }

  .sidebar-otras-areas {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem;
    border: 1px solid rgba(15, 27, 61, 0.08);
    border-radius: var(--radius-card);
  }

  .sidebar-otras-titulo {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-400);
    margin-bottom: 0.5rem;
  }

  .sidebar-area-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-ink-600);
    text-decoration: none;
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    transition:
      color var(--motion-duration-micro) var(--motion-ease-micro),
      background var(--motion-duration-micro) var(--motion-ease-micro);
  }

  .sidebar-area-link:hover {
    color: var(--color-navy-800);
    background: rgba(15, 27, 61, 0.04);
  }

  .sidebar-area-link-highlight {
    color: var(--color-terracotta-600);
    font-weight: 600;
  }

  .sidebar-area-link-highlight:hover {
    color: var(--color-terracotta-500);
  }

  @media (max-width: 900px) {
    .area-main-inner {
      grid-template-columns: 1fr;
    }

    .sidebar-card {
      position: static;
    }
  }
</style>
